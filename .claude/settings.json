{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "say 'Task successful' & afplay /System/Library/Sounds/Glass.aiff",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "say 'Task failed' & afplay /System/Library/Sounds/Sosumi.aiff",
            "async": true
          }
        ]
      }
    ]
  }
}
